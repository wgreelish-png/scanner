# Server-only values. Generate a unique device token (for example openssl rand -hex 32).
# Empty RESEARCH_DEVICE_TOKEN intentionally prevents startup.
RESEARCH_DEVICE_TOKEN=
TCG_BETA_SHIPPER_ID=
TCG_BETA_API_KEY=
HOST=127.0.0.1
PORT=8787

# Optional authorized service, not a guessed official PSA endpoint.
# The endpoint must return the normalized response documented in README.md.
# Example: https://your-trusted-cert-service.example/certs/{certificateNumber}
PSA_CERT_SERVICE_URL_TEMPLATE=
PSA_CERT_SERVICE_TOKEN=
